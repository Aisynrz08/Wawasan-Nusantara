b; }\n.pause-list li.is-disabled::after { content: \" (segera)\"; font-size: 0.6em; }\n\n.pause-hint {\n  margin-top: 1.2em; text-align: center;\n  color: #94a3b8; font-family: sans-serif; font-size: 0.9em;\n}\n</style>\n\n<div class=\"pause-stage\">\n  <div class=\"pause-card\"></div>\n</div>",0,false,"","",false,0,4,true,[0,0,0],false,[1,1,1],true,false,""],""],[[640,360,0,1280,720,0,0,[1,1,1,1],0.5,0.5,0,0,0,[],null,null,null,null,null],9,15,[],[],["div","<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n  <style>\n@font-face {\n    font-family: \"Silkscreen\";\n    src: url(\"./Silkscreen-Regular.woff2\") format(\"woff2\");\n    font-weight: 400;\n    font-style: normal;\n    font-display: swap;\n}\n\n@font-face {\n    font-family: \"Silkscreen\";\n    src: url(\"./Silkscreen-Bold.woff2\") format(\"woff2\");\n    font-weight: 700;\n    font-style: normal;\n    font-display: swap;\n}\n\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    body {\n      background: #0f172a;\n      font-family: 'Silkscreen', monospace;\n    }\n\n    /* Kotak acuan: mengisi viewport (atau kotak HTML Element di Construct) */\n    .stage {\n  position: absolute;\n  inset: 0;\n  container-type: size;\n  display: grid;\n  place-items: center;\n  isolation: isolate;\n}\n\n.stage-backdrop {\n  position: fixed;\n  width: 100 dvw;\n  height: 100 dvh;\n  inset: 0;\n  z-index: -1;\n  background: rgba(0, 0, 0, 0.3);\n}\n\n    /* Panel: rasio terkunci, tidak pernah keluar dari stage */\n    .scroll-container {\n      --ratio: 1.05;   /* tinggi / lebar */\n      --fill: 0.95;    /* porsi maksimum dari stage */\n\n      position: relative;\n      width: min(500px, calc(100cqw * var(--fill)), calc(100cqh * var(--fill) / var(--ratio)));\n      aspect-ratio: 1 / var(--ratio);\n      container-type: inline-size;   /* acuan font (cqw) */\n\n      background: url('fragmenPanel.png') center / 100% 100% no-repeat;\n      image-rendering: pixelated;\n    }\n\n    /* Area kertas: posisinya menempel ke panel lewat persentase, bukan margin-top */\n    .scroll-content {\n      position: absolute;\n      inset: 23.6% 23.2% 21.4% 23%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      overflow: hidden;\n      font-size: max(8px, 2.4cqw);\n      color: #5a2e0c;\n      text-align: center;\n    }\n\n    /* Header: tidak ikut scroll */\n    .scroll-header {\n      flex-shrink: 0;\n      width: 100%;\n    }\n\n    .scroll-title {\n      font-size: 1.75em;\n      font-weight: 700;\n      line-height: 1.2;\n      margin-bottom: 0.55em;\n      overflow-wrap: anywhere;\n    }\n\n    .divider {\n      width: 75%;\n      margin: 0 auto 1em;\n      border-bottom: 1px solid #5a2e0c;\n      opacity: 0.3;\n    }\n\n    /* Body: mengisi sisa ruang dan scroll kalau isinya kelewat */\n    .scroll-body {\n      flex: 1;\n      min-height: 0;                 /* wajib agar flex child bisa scroll */\n      width: 100%;\n      overflow-y: auto;\n      overscroll-behavior: contain;  /* scroll ga merambat ke halaman/canvas */\n      scrollbar-width: thin;\n      scrollbar-color: #8b5a2b rgba(90, 46, 12, 0.15);\n      scrollbar-gutter: stable both-edges; /* teks tetap simetris di tengah */\n    }\n\n    .scroll-body:focus-visible {\n      outline: 2px dashed rgba(90, 46, 12, 0.6);\n      outline-offset: -2px;\n    }\n\n    .scroll-body p {\n      line-height: 1.6;\n      margin-bottom: 1em;\n      overflow-wrap: anywhere;\n    }\n  </style>\n</head>\n\n<body>\n  <div class=\"stage\">\n    <div class=\"stage-backdrop\"></div>\n    <div class=\"scroll-container\">\n      <div class=\"scroll-content\">\n\n        <div class=\"scroll-header\">\n          <h1 class=\"scroll-title\" id=\"fragment-title\">MISTERI GULUNGAN KUNO</h1>\n          <div class=\"divider\"></div>\n        </div>\n\n        <div class=\"scroll-body\" id=\"fragm